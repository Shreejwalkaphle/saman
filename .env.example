# Copy this file to .env.properties for local development and replace every
# placeholder. The real .env.properties file is ignored by Git and is not
# packaged into the application JAR.
DB_URL=jdbc:postgresql://localhost:5432/saman_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-encoded
ADMIN_BOOTSTRAP_EMAIL=admin@saman.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
ESEWA_PRODUCT_CODE=replace-with-your-esewa-product-code
ESEWA_SECRET_KEY=replace-with-your-esewa-merchant-secret
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=http://localhost:4200/payment/esewa/success
ESEWA_FAILURE_URL=http://localhost:4200/payment/esewa/failure
